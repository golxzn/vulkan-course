{
	"version": 7,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 30,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "common",
			"hidden": true,
			"binaryDir": "build/${presetName}",
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": true
			}
		},

		{
			"name": "ninja",
			"hidden": true,
			"generator": "Ninja",
			"architecture": {
				"value": "x64",
				"strategy": "external"
			}
		},

		{
			"name": "clang",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang",
				"CMAKE_CXX_COMPILER": "clang++"
			}
		},


		{
			"name": "ninja-clang-x64-dev",
			"inherits": [ "common", "ninja", "clang" ],
			"displayName": "[Ninja][Clang][Dev] x64 development",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
		},
		{
			"name": "ninja-clang-x64-rel",
			"inherits": [ "common", "ninja", "clang" ],
			"displayName": "[Ninja][Clang][Rel] x64 development",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
		}
	],
	"buildPresets": [
		{
			"name": "base",
			"hidden": true,
			"jobs": 16
		},

		{ "name": "ninja-clang-x64-dev-dev", "displayName": "Clang Dev", "configurePreset": "ninja-clang-x64-dev", "configuration": "Debug",   "inherits": [ "base" ] },
		{ "name": "ninja-clang-x64-dev-rel", "displayName": "Clang Rel", "configurePreset": "ninja-clang-x64-rel", "configuration": "Release", "inherits": [ "base" ] }
	]
}